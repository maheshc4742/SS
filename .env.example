# ==========================================
# ScriptSense Environment Configuration
# ==========================================

# OCR Provider: "gemini" or "qwen"
OCR_PROVIDER=gemini

# Google Gemini API Settings
# Get API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local Qwen Vision-Language Model Settings (e.g. via LM Studio, vLLM, Ollama, or OpenAI-compatible endpoint)
QWEN_BASE_URL=http://127.0.0.1:1234/v1
QWEN_MODEL=qwen2-vl-7b-instruct
QWEN_API_KEY=not-needed

# Semantic Evaluation Model ("codbert_base" or fine-tuned versions e.g. "codbert_ft_v1")
ACTIVE_SEMANTIC_MODEL=codbert_base

# Human-In-The-Loop Training Threshold
# Minimum verified samples required before enabling fine-tuning
MIN_TRAINING_SAMPLES=10

# Database
DATABASE_URL=sqlite:///./data/scriptsense.db

# Server Config
HOST=127.0.0.1
PORT=8000
